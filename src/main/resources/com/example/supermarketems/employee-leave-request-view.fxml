<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" prefWidth="480.0"
      style="-fx-background-color: #f8fafc; -fx-padding: 24;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.supermarketems.controller.LeaveRequestController">

    <!-- Header Section -->
    <VBox spacing="4.0">
        <Label text="Apply for Leave"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
        <Label text="Submit a formal leave application for manager approval."
               style="-fx-font-size: 13px; -fx-text-fill: #64748b;" />
    </VBox>

    <!-- Form Fields Container -->
    <GridPane hgap="12.0" vgap="16.0">

        <!-- Leave Type -->
        <Label text="Leave Type:"
               GridPane.columnIndex="0" GridPane.rowIndex="0"
               style="-fx-font-weight: bold; -fx-text-fill: #334155;" />
        <ComboBox fx:id="leaveTypeCombo"
                  promptText="Select Leave Type"
                  maxWidth="320.0"
                  GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.hgrow="ALWAYS"
                  style="-fx-font-size: 13px;" />

        <!-- Start Date -->
        <Label text="Start Date:"
               GridPane.columnIndex="0" GridPane.rowIndex="1"
               style="-fx-font-weight: bold; -fx-text-fill: #334155;" />
        <DatePicker fx:id="startDatePicker"
                    promptText="Pick start date"
                    maxWidth="320.0"
                    GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.hgrow="ALWAYS" />

        <!-- End Date -->
        <Label text="End Date:"
               GridPane.columnIndex="0" GridPane.rowIndex="2"
               style="-fx-font-weight: bold; -fx-text-fill: #334155;" />
        <DatePicker fx:id="endDatePicker"
                    promptText="Pick end date"
                    maxWidth="320.0"
                    GridPane.columnIndex="1" GridPane.rowIndex="2" GridPane.hgrow="ALWAYS" />

        <!-- Reason -->
        <Label text="Reason:"
               GridPane.columnIndex="0" GridPane.rowIndex="3"
               style="-fx-font-weight: bold; -fx-text-fill: #334155;"
               GridPane.valignment="TOP" />
        <TextArea fx:id="reasonTextArea"
                  promptText="Provide a brief explanation for your leave..."
                  prefRowCount="4"
                  wrapText="true"
                  GridPane.columnIndex="1" GridPane.rowIndex="3" GridPane.hgrow="ALWAYS"
                  style="-fx-font-size: 13px;" />
    </GridPane>

    <!-- Action Buttons -->
    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <Button text="Cancel"
                onAction="#handleCancel"
                style="-fx-background-color: #e2e8f0; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand;" />
        <Button text="Submit Request"
                onAction="#handleSubmit"
                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 18; -fx-background-radius: 6; -fx-cursor: hand;" />
    </HBox>

</VBox>
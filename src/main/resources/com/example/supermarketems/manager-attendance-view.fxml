<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #f8fafc; -fx-padding: 25;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.supermarketems.controller.ManagerAttendanceController">

    <!-- Top Header -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 0 0 20 0;">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label style="-fx-text-fill: #0f172a; -fx-font-size: 22px; -fx-font-weight: bold;" text="ATTENDANCE &amp; OVERTIME MANAGEMENT" />
                <Label style="-fx-text-fill: #64748b; -fx-font-size: 13px;" text="Monitor shift logs, approve overtime hours, and review attendance records" />
            </VBox>
            <Button onAction="#handleBackToDashboard" style="-fx-background-color: #ffffff; -fx-text-fill: #334155; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="Back to Dashboard" />
        </HBox>
    </top>

    <!-- Center Content Area -->
    <center>
        <VBox spacing="15">

            <!-- Filter Controls Bar -->
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #ffffff; -fx-padding: 15; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;">
                <TextField fx:id="txtSearchEmployee" prefWidth="220" promptText="Search Employee Name or ID..." style="-fx-background-color: #f8fafc; -fx-text-fill: #0f172a; -fx-prompt-text-fill: #94a3b8; -fx-padding: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6;" />

                <DatePicker fx:id="dateFilter" prefWidth="150" promptText="Select Date" style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 6;" />

                <ComboBox fx:id="cmbStatusFilter" prefWidth="140" promptText="Status Filter" style="-fx-background-color: #f8fafc; -fx-text-fill: #0f172a; -fx-border-color: #cbd5e1; -fx-border-radius: 6;" />

                <Button onAction="#handleFilterLogs" style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16; -fx-cursor: hand; -fx-background-radius: 6;" text="Filter Logs" />

                <Button onAction="#handleResetFilters" style="-fx-background-color: #e2e8f0; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-padding: 8 16; -fx-cursor: hand; -fx-background-radius: 6;" text="Reset" />
            </HBox>

            <!-- Attendance & Overtime Table -->
            <TableView fx:id="tblAttendance" style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colEmpId" prefWidth="90" text="Emp ID" />
                    <TableColumn fx:id="colEmpName" prefWidth="160" text="Employee Name" />
                    <TableColumn fx:id="colDate" prefWidth="110" text="Date" />
                    <TableColumn fx:id="colClockIn" prefWidth="100" text="Clock In" />
                    <TableColumn fx:id="colClockOut" prefWidth="100" text="Clock Out" />
                    <TableColumn fx:id="colWorkHours" prefWidth="100" text="Work Hours" />
                    <TableColumn fx:id="colOvertimeHours" prefWidth="90" text="OT Hours" />
                    <TableColumn fx:id="colMethod" prefWidth="80" text="Method" />
                    <TableColumn fx:id="colOtStatus" prefWidth="120" text="OT Status" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <!-- Overtime Action Controls -->
            <HBox alignment="CENTER_RIGHT" spacing="12" style="-fx-background-color: #ffffff; -fx-padding: 12 20; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;">
                <Label style="-fx-text-fill: #64748b; -fx-font-size: 13px; -fx-font-weight: bold;" text="Selected Overtime Record:" />
                <Button onAction="#handleApproveOvertime" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 18; -fx-cursor: hand; -fx-background-radius: 6;" text="Approve OT" />
                <Button onAction="#handleRejectOvertime" style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 18; -fx-cursor: hand; -fx-background-radius: 6;" text="Reject OT" />
            </HBox>

        </VBox>
    </center>
</BorderPane>

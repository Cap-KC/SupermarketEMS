<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" prefWidth="380.0" prefHeight="420.0"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.supermarketems.controller.LoginController"
      style="-fx-background-color: #f4f4f4; -fx-padding: 30;">

    <Label text="Supermarket EMS" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;">
        <font>
            <Font size="24.0" />
        </font>
    </Label>

    <Label text="Employee Login" style="-fx-text-fill: #7f8c8d;">
        <font>
            <Font size="14.0" />
        </font>
    </Label>

    <VBox spacing="5.0" alignment="CENTER_LEFT" prefWidth="300.0">
        <Label text="Email Address:" style="-fx-font-weight: bold;"/>
        <TextField fx:id="emailField" promptText="e.g. kasun@supermarket.lk"
                   style="-fx-pref-height: 35; -fx-background-radius: 5;"/>
    </VBox>

    <VBox spacing="5.0" alignment="CENTER_LEFT" prefWidth="300.0">
        <Label text="Password:" style="-fx-font-weight: bold;"/>
        <PasswordField fx:id="passwordField" promptText="Enter your password"
                       style="-fx-pref-height: 35; -fx-background-radius: 5;"/>
    </VBox>

    <Button text="Login" onAction="#handleLogin"
            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 38; -fx-pref-width: 300; -fx-background-radius: 5; -fx-cursor: hand;"/>

    <Label fx:id="statusLabel" text="" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;" wrapText="true"/>

</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.supermarketems.controller.AuditLogController">
    <top>
        <VBox spacing="10.0" style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleBackToDashboard" style="-fx-background-color: #2c3e50; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-cursor: hand;" text="← Back to Dashboard" />
                        <Label text="System Audit Logs" textFill="#1e293b">
                            <font>
                                <Font name="System Bold" size="22.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>
    <center>
        <VBox spacing="15.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <!-- Filter Bar -->
                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #ffffff; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8;">
                    <children>
                        <Label text="Search:" textFill="#475569">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <TextField fx:id="searchField" prefWidth="250.0" promptText="Search by ID, User, or Keyword..." style="-fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-background-radius: 4;" />

                        <Label text="Action Type:" textFill="#475569">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                            <HBox.margin>
                                <Insets bottom="0.0" left="10.0" right="0.0" top="0.0" />
                            </HBox.margin>
                        </Label>
                        <ComboBox fx:id="actionTypeFilterComboBox" prefWidth="180.0" style="-fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-background-radius: 4;" />

                        <Button mnemonicParsing="false" onAction="#handleRefresh" style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Refresh Logs" />
                    </children>
                </HBox>

                <!-- Audit Logs Table -->
                <TableView fx:id="auditTable" style="-fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colLogId" prefWidth="120.0" text="Log ID" />
                        <TableColumn fx:id="colTimestamp" prefWidth="160.0" text="Timestamp" />
                        <TableColumn fx:id="colPerformedBy" prefWidth="130.0" text="Performed By" />
                        <TableColumn fx:id="colActionType" prefWidth="140.0" text="Action Type" />
                        <TableColumn fx:id="colIpAddress" prefWidth="120.0" text="IP Address" />
                        <TableColumn fx:id="colDescription" prefWidth="280.0" text="Description / Details" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1150.0" style="-fx-background-color: #f8f9fa;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.supermarketems.controller.ShiftScheduleController">

    <!-- TOP HEADER BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #2c3e50; -fx-padding: 15 25;">
            <Button onAction="#handleBackToDashboard"
                    style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 6;"
                    text="⬅ Back to Dashboard" />
            <VBox spacing="2.0">
                <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="Shift Schedule Management">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>
                <Label style="-fx-text-fill: #bdc3c7;" text="Manage store department working hours and schedules">
                    <font>
                        <Font size="12.0" />
                    </font>
                </Label>
            </VBox>
        </HBox>
    </top>

    <!-- CENTER CONTENT -->
    <center>
        <HBox spacing="20.0" style="-fx-padding: 20;">

            <!-- LEFT FORM PANEL -->
            <VBox prefWidth="350.0" spacing="12.0"
                  style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">

                <Label fx:id="formTitleLabel" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="📅 Assign Schedule">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>

                <!-- Schedule ID Input -->
                <VBox spacing="4.0">
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #34495e;" text="Schedule ID *" />
                    <TextField fx:id="scheduleIdField" promptText="e.g., SCH-001" style="-fx-padding: 8; -fx-background-radius: 4;" />
                </VBox>

                <!-- Employee Dropdown Selection -->
                <VBox spacing="4.0">
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #34495e;" text="Select Employee *" />
                    <ComboBox fx:id="employeeComboBox" maxWidth="1.7976931348623157E308" promptText="Select Employee..." style="-fx-padding: 4; -fx-background-radius: 4;" />
                </VBox>

                <!-- Shift Date Input -->
                <VBox spacing="4.0">
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #34495e;" text="Shift Date *" />
                    <DatePicker fx:id="shiftDatePicker" maxWidth="1.7976931348623157E308" promptText="Select Date" style="-fx-padding: 4; -fx-background-radius: 4;" />
                </VBox>

                <!-- Start and End Time Inputs -->
                <HBox spacing="10.0">
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #34495e;" text="Start Time (HH:mm) *" />
                        <TextField fx:id="startTimeField" promptText="08:00" style="-fx-padding: 8; -fx-background-radius: 4;" />
                    </VBox>
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #34495e;" text="End Time (HH:mm) *" />
                        <TextField fx:id="endTimeField" promptText="16:00" style="-fx-padding: 8; -fx-background-radius: 4;" />
                    </VBox>
                </HBox>

                <!-- Department Input -->
                <VBox spacing="4.0">
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #34495e;" text="Department" />
                    <TextField fx:id="departmentField" promptText="e.g., Bakery, Cashier, Inventory" style="-fx-padding: 8; -fx-background-radius: 4;" />
                </VBox>

                <!-- Managed By Input -->
                <VBox spacing="4.0">
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #34495e;" text="Managed By" />
                    <TextField fx:id="managedByField" promptText="e.g., Admin Name" style="-fx-padding: 8; -fx-background-radius: 4;" />
                </VBox>

                <!-- Status Feedback Label -->
                <Label fx:id="statusLabel" wrapText="true" style="-fx-font-size: 12px;" />

                <Region VBox.vgrow="ALWAYS" />

                <!-- Action Buttons -->
                <VBox spacing="8.0">
                    <Button fx:id="saveButton" maxWidth="1.7976931348623157E308" onAction="#handleSaveShift"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10; -fx-cursor: hand; -fx-background-radius: 4;"
                            text="Save Schedule" />

                    <HBox spacing="8.0">
                        <Button maxWidth="1.7976931348623157E308" onAction="#handleClearForm"
                                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 4;"
                                text="Clear Form" HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>

            </VBox>

            <!-- RIGHT TABLE & FILTER PANEL -->
            <VBox spacing="12.0"
                  style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);"
                  HBox.hgrow="ALWAYS">

                <!-- Filter Controls Bar -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <TextField fx:id="searchField" promptText="🔍 Search Schedule ID, Emp Name, Dept, or Manager..."
                               style="-fx-padding: 8; -fx-background-radius: 4;" HBox.hgrow="ALWAYS" />

                    <DatePicker fx:id="filterStartDatePicker" promptText="From Date" prefWidth="130.0" />
                    <DatePicker fx:id="filterEndDatePicker" promptText="To Date" prefWidth="130.0" />

                    <Button onAction="#handleFilterByDate"
                            style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 4; -fx-padding: 8 12;"
                            text="Filter" />
                    <Button onAction="#handleResetFilter"
                            style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 4; -fx-padding: 8 12;"
                            text="Reset" />
                </HBox>

                <!-- Table View -->
                <TableView fx:id="shiftTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colScheduleId" prefWidth="100.0" text="Schedule ID" />
                        <TableColumn fx:id="colEmployeeId" prefWidth="100.0" text="Emp ID" />
                        <TableColumn fx:id="colEmployeeName" prefWidth="140.0" text="Employee Name" />
                        <TableColumn fx:id="colDate" prefWidth="110.0" text="Shift Date" />
                        <TableColumn fx:id="colStartTime" prefWidth="90.0" text="Start Time" />
                        <TableColumn fx:id="colEndTime" prefWidth="90.0" text="End Time" />
                        <TableColumn fx:id="colDepartment" prefWidth="120.0" text="Department" />
                        <TableColumn fx:id="colManagedBy" prefWidth="130.0" text="Managed By" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <!-- Table Context Action Buttons -->
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <Button onAction="#handleEditSelected"
                            style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 4; -fx-padding: 8 16;"
                            text="✏️ Edit Selected" />
                    <Button onAction="#handleDeleteSelected"
                            style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 4; -fx-padding: 8 16;"
                            text="🗑️ Delete Selected" />
                </HBox>

            </VBox>

        </HBox>
    </center>
</BorderPane>
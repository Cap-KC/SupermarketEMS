<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.supermarketems.controller.PermanentEmployeeDashboardController">

    <!-- TOP HEADER BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #1e293b; -fx-padding: 15px 25px;">
            <children>
                <VBox HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="welcomeLabel" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="Welcome Back 👋" />
                        <HBox spacing="15.0">
                            <children>
                                <Label fx:id="empIdLabel" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" text="ID: EMP-PERM01" />
                                <Label fx:id="designationLabel" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" text="Role: Permanent Staff" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <Button onAction="#handleLogout" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Logout" />
            </children>
        </HBox>
    </top>

    <!-- MAIN CONTENT AREA -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f8fafc;">
            <content>
                <VBox spacing="20.0" style="-fx-padding: 25px;">
                    <children>

                        <!-- METRIC & ACTION CARDS -->
                        <HBox spacing="20.0">
                            <children>
                                <!-- Status Card -->
                                <VBox alignment="CENTER" prefHeight="100.0" style="-fx-background-color: white; -fx-background-radius: 8px; -fx-padding: 15px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 12px;" text="CURRENT STATUS" />
                                        <Label fx:id="statusLabel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0284c7;" text="OFF SHIFT" />
                                    </children>
                                </VBox>

                                <!-- Leave Allowance Card -->
                                <VBox alignment="CENTER" prefHeight="100.0" style="-fx-background-color: white; -fx-background-radius: 8px; -fx-padding: 15px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 12px;" text="REMAINING LEAVE DAYS" />
                                        <Label fx:id="remainingLeaveLabel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #16a34a;" text="14" />
                                    </children>
                                </VBox>

                                <!-- Quick Actions Panel -->
                                <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8px; -fx-padding: 15px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER" spacing="10.0">
                                            <children>
                                                <Button fx:id="clockInBtn" onAction="#handleClockIn" prefWidth="110.0" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Clock In" />
                                                <Button fx:id="clockOutBtn" onAction="#handleClockOut" prefWidth="110.0" style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Clock Out" />
                                            </children>
                                        </HBox>
                                        <HBox alignment="CENTER" spacing="10.0">
                                            <children>
                                                <Button onAction="#handleRequestLeave" prefWidth="110.0" style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Request Leave" />
                                                <Button onAction="#handleViewPayslips" prefWidth="110.0" style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="My Payslips" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- TABLES SECTION -->
                        <HBox spacing="20.0">
                            <children>
                                <!-- Attendance Table -->
                                <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8px; -fx-padding: 15px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Recent Shift Activity" />
                                        <TableView fx:id="attendanceTable" prefHeight="280.0">
                                            <columns>
                                                <TableColumn fx:id="colClockIn" prefWidth="160.0" text="Clock In" />
                                                <TableColumn fx:id="colClockOut" prefWidth="160.0" text="Clock Out" />
                                                <TableColumn fx:id="colOvertime" prefWidth="100.0" text="OT Hours" />
                                            </columns>
                                        </TableView>
                                    </children>
                                </VBox>

                                <!-- Leave Requests Table -->
                                <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8px; -fx-padding: 15px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="My Leave Applications" />
                                        <TableView fx:id="leaveTable" prefHeight="280.0">
                                            <columns>
                                                <TableColumn fx:id="colLeaveType" prefWidth="110.0" text="Type" />
                                                <TableColumn fx:id="colStartDate" prefWidth="110.0" text="Start Date" />
                                                <TableColumn fx:id="colEndDate" prefWidth="110.0" text="End Date" />
                                                <TableColumn fx:id="colStatus" prefWidth="90.0" text="Status" />
                                            </columns>
                                        </TableView>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>